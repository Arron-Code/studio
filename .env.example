# API-Key-Absicherung: Pflicht, sobald dieser Service aus dem Internet erreichbar
# ist (z.B. damit das auf Vercel gehostete Medeber-Projekt zugreifen kann).
# Erzeugen z.B. mit: openssl rand -hex 32
AI_PIPELINE_API_KEY=""

# Kommagetrennte Liste erlaubter Origins für CORS, z.B. https://medeber.vercel.app
# Leer oder "*" erlaubt alle Origins (nur für rein lokale Entwicklung sinnvoll).
AI_PIPELINE_CORS_ORIGINS="*"
